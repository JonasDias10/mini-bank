{
  "consumer": {
    "name": "account-service"
  },
  "messages": [
    {
      "contents": {
        "accountId": 1,
        "amount": 100.0,
        "operationId": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
        "type": "CREDIT"
      },
      "description": "a credit command",
      "generators": {
        "body": {
          "$.operationId": {
            "type": "Uuid"
          }
        }
      },
      "matchingRules": {
        "body": {
          "$.accountId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.amount": {
            "combine": "AND",
            "matchers": [
              {
                "match": "number"
              }
            ]
          },
          "$.operationId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          }
        }
      },
      "metaData": {
        "contentType": "application/json"
      }
    },
    {
      "contents": {
        "accountId": 1,
